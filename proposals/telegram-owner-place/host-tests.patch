@@ -0,0 +1,371 @@
+"""Place custody is not permission to acknowledge or reroute an unreadable update.
+
+Uses the real Telegram skill/Host fixture with private SQLite files. The provider and
+model remain doubles; these checks do not claim a live Telegram outage was exercised.
+"""
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import json
+import sqlite3
+import time
+from pathlib import Path, PurePosixPath, PureWindowsPath
+
+import pytest
+
+from tests import test_telegram_places as places_suite
+from tests.test_telegram_places import BOT, GUEST, OWNER, _custody, _message, _receive, _run
+
+pytestmark = pytest.mark.serial
+env = places_suite.env
+
+
+def test_absent_custody_reads_do_not_create_a_database(env):
+    path = env.tp._path(env.api)
+    assert not path.exists()
+    assert not env.tp.retained(env.api, 1)
+    assert not env.tp.room_event(env.api, {"chat_id": 1})
+    assert env.tp.status(env.api)["inbox_open"] == 0
+    assert not path.exists() and str(path) not in env.tp._READY
+
