+"""Telegram private chats as Places against the real Host Service app.
+
+The Host runs in process (ASGI) on a private data root: real place admission,
+capture, wake decision, turn custody, live-author mail, work views, delivery
+receipts and the owner chat ingress (``/chat/inject`` into the canonical store,
+with a recording bridge in place of the supervisor). Only the model (a scripted
+agent) and Telegram (a recorded wire) are doubles; no network, no live bot. The
+bridge's own handler, runner and tools are the production code.
+"""
+from __future__ import annotations
+
+import asyncio
+import copy
+import json
+import sys
+import threading
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from ouroboros import places
+from ouroboros.gateway import host_service
+from ouroboros.presence_runner import build_presence_result_event, run_presence_turn
+from ouroboros.task_results import write_task_result
+from tests.test_telegram_format_parity import _load_skill
+
+# The shared native-skill loader replaces its package entries in sys.modules.
+pytestmark = pytest.mark.serial
+
+BOT, OWNER, GUEST = "777", 42, 99
+
+
+class Token:
+    def use_in_request(self):
+        return "synthetic-skill-token"
+
+
+class Api:
+    def __init__(self, state_dir: Path, data_dir: Path):
+        self.state_dir, self.data_dir = state_dir, data_dir
+        self.logs, self.tasks, self.tools = [], {}, {}
+        state_dir.mkdir(parents=True, exist_ok=True)
+
+    def get_state_dir(self):
+        return str(self.state_dir)
+
+    def get_runtime_info(self):
+        return {"data_dir": str(self.data_dir)}
+
+    def get_settings(self, _keys):
+        return {"TELEGRAM_BOT_TOKEN": "synthetic-token"}
+
+    def get_skill_token(self):
+        return Token()
+
+    def log(self, level, message):
+        self.logs.append((level, message))
+
+    def register_supervised_task(self, name, factory, **_kwargs):
+        self.tasks[name] = factory
+
+    def register_tool(self, name, handler, **kwargs):
+        self.tools[name] = (handler, kwargs)
+
+
+class Wire:
+    """Recorded Telegram Bot API; scripted failures pop in order, ``after_send`` observes sends."""
+
+    def __init__(self):
+        self.calls, self.failures, self.next_id, self.updates = [], [], 500, []
+        self.after_send = None
+        self.download_failures = []
+
+    async def call(self, method, *, data=None, files=None, timeout=30):
+        self.calls.append((method, dict(data or {})))
+        if self.failures:
+            failure = self.failures.pop(0)
+            if isinstance(failure, BaseException):
+                raise failure
+            if isinstance(failure, dict):
+                return failure
+        if method == "setMessageReaction":
+            return {"ok": True, "result": True}
+        self.next_id += 1
+        result = {"ok": True, "result": {"message_id": self.next_id, "date": 1_800_000_000}}
+        if method == "sendMessage" and self.after_send is not None:
+            self.after_send(data)
+        return result
+
+    async def send_message(self, chat_id, text, parse_mode="HTML"):
+        return (await self.call("sendMessage", data={"chat_id": str(chat_id), "text": text}))["result"]["message_id"]
+
+    async def send_message_with_inline_keyboard(self, chat_id, text, keyboard, parse_mode="HTML"):
+        return await self.send_message(chat_id, text)
+
+    async def answer_callback_query(self, callback_query_id, *, text=""):
+        self.calls.append(("answerCallbackQuery", {"callback_query_id": callback_query_id}))
+
+    async def edit_message_text_with_inline_keyboard(self, chat_id, message_id, text, keyboard, parse_mode="HTML"):
+        self.calls.append(("editMessageText", {"chat_id": str(chat_id), "message_id": message_id}))
+        return True
+
+    async def send_document(self, chat_id, data, *, filename="file", caption=""):
+        await self.call("sendDocument", data={"chat_id": str(chat_id), "filename": filename})
+
+    async def send_photo(self, chat_id, image_base64, *, caption="", mime="image/png", parse_mode="HTML"):
+        await self.call("sendPhoto", data={"chat_id": str(chat_id), "caption": caption})
+
+    async def get_updates(self, offset):
+        await asyncio.sleep(0.02)
+        return self.updates.pop(0) if self.updates else []
+
+    async def download_photo(self, _file_id):
+        self.calls.append(("download", {}))
+        while getattr(self, "download_gate", None) is not None and not self.download_gate.is_set():
+            await asyncio.sleep(0.05)  # a slow Telegram file server
+        if self.download_failures:
+            raise self.download_failures.pop(0)
+        return "aGVsbG8=", "image/jpeg"
+
+    async def download_file(self, _file_id):
+        self.calls.append(("download", {}))
+        if self.download_failures:
+            raise self.download_failures.pop(0)
+        return b"file bytes"
+
+    def sent(self):
+        return [data for method, data in self.calls if method == "sendMessage"]
+
+
+class Model:
+    """A scripted mind: records each focus, optionally holds it open as a live author."""
+
+    def __init__(self, root: Path):
+        self.root, self.tasks, self.reply = root, [], "Seen: {text}"
+        self.hold = threading.Event()
+        self.hold.set()
+        self.during = None  # called with the task while the focus is open
+
+    def handle_task(self, task):
+        self.tasks.append(task)
+        self._owner_message_admission_lock = threading.RLock()
+        self._accepting_owner_messages, self._busy, self._current_task_id = True, True, task["id"]
+        if self.during is not None:
+            self.during(task)
+        self.hold.wait(20)
+        self._accepting_owner_messages = self._busy = False
+        from ouroboros.tools.registry import ToolContext
+
+        text = self.reply.format(text=task["metadata"]["presence"]["observed_text"])
+        ctx = ToolContext(repo_dir=self.root, drive_root=self.root, budget_drive_root=self.root,
+                          task_id=task["id"], task_metadata=task["metadata"])
+        # The agent's own finalization mints the canonical output identity, as in production.
+        result = build_presence_result_event(task, text, ctx, terminal_origin="model_final")
+        write_task_result(self.root, task["id"], "completed", metadata=task["metadata"],
+                          terminal_origin="model_final", result=text)
+        return [result]
+
+
+class Bridge:
+    """The supervisor seam behind the Host's real ``/chat/inject`` acceptance."""
+
+    def __init__(self):
+        self.messages = []
+
+    def enqueue_local_message(self, text, **kwargs):
+        self.messages.append({"text": text, **kwargs})
+
+
+def _message(mid, text="Hello there", *, chat=OWNER, sender=None, **extra):
+    sender = OWNER if sender is None and chat == OWNER else (sender or chat)
+    return {"message_id": mid, "date": int(time.time()), "chat": {"id": chat, "type": "private"},
+            "from": {"id": sender, "first_name": "Ann" if sender == OWNER else "Guest"}, "text": text, **extra}
+
+
+@pytest.fixture
+def env(tmp_path, monkeypatch):
+    plugin, telegram_api = _load_skill()
+    package = plugin.__package__
+    tp, ta, tn = (sys.modules[f"{package}.lib.{name}"] for name in ("telegram_places", "telegram_actions", "telegram_news"))
+    state = sys.modules[package + ".lib.telegram_state"]
+    root = tmp_path / "data"
+    root.mkdir()
+    bridge = Bridge()
+    app = host_service.create_host_service_app(root, bridge_getter=lambda: bridge)
+    # The Host confines staged files to this skill's own state root, as in production.
+    api = Api(app.state.host_service_context.skills_state_dir / "telegram", root)
+    (api.state_dir / "settings.json").write_text(json.dumps({"TELEGRAM_CHAT_ID": str(OWNER),
+                                                          "TELEGRAM_ORDINARY_CHAT": "place"}), encoding="utf-8")
+    for module, name, value in ((tp, "_BOT", {}), (tp, "_IDENTITY", {"at": 0.0, "body": {}}), (tp, "_READY", set()),
+                                (tp, "_ROOMS", {}), (tp, "HOLD_RECHECK_SEC", 0.2)):
+        monkeypatch.setattr(module, name, value)
+    tp.remember_bot(api, {"id": int(BOT), "username": "obot"})
+
+    async def authenticated(*_args):
+        return "telegram", {}
+
+    monkeypatch.setattr(host_service, "_authenticated", authenticated)
+    monkeypatch.setattr("ouroboros.presence_admission.focus_enabled", lambda _root: True)
+    monkeypatch.setattr("ouroboros.presence_admission.focus_allowance",
+                        lambda _root: {"status": "available", "remaining_usd": 5, "settled_usd": 0})
+    monkeypatch.setattr("ouroboros.safety.check_safety", lambda *_a, **_kw: (True, ""))
+    model = Model(root)
+    app.state.host_service_context.presence_runner = lambda **kw: run_presence_turn(
+        repo_dir=root, drive_root=root, agent_factory=lambda **_kw: model, **kw)
+    transport = httpx.ASGITransport(app=app)
+    monkeypatch.setattr(tp, "_TRANSPORT", transport)
+    wire = Wire()
+    monkeypatch.setattr(plugin, "_telegram_client", lambda *_a, **_kw: wire)
+    injects = []
+
+    async def host_post(_api, path, payload):
+        injects.append((path, payload))
+        if path == "/chat/inject" and payload.get("text") != "/panic":  # the real owner ingress
+            async with httpx.AsyncClient(transport=transport, base_url="http://host") as client:
+                response = await client.post(path, json=payload, headers={"X-Skill-Token": "synthetic"})
+            return response.status_code, response.json()
+        return 202, {"ok": True, "status": "queued"}
+
+    monkeypatch.setattr(plugin, "_host_post", host_post)
+    place = places.connect_place(root, connector="telegram", provider="telegram", account_id=BOT,
+                                 wakes=["direct_message"])
+    places.edit_place(root, place.place_id, "confirm_owner_account", author="owner",
+                      platform_actor_id=str(OWNER), label="Ann")
+    ta.register(api, client_factory=lambda: wire, relay=plugin._relay_owner_message, owner=lambda: str(OWNER))
+    runner = tp.Runner(api, client_factory=lambda: wire, classic=_classic(plugin, api, wire))
+    return SimpleNamespace(plugin=plugin, tp=tp, ta=ta, tn=tn, state=state, api=api, root=root, model=model,
+                           wire=wire, injects=injects, place=place, runner=runner, app=app, bridge=bridge,
+                           telegram_api=telegram_api)
+
+
+def _classic(plugin, api, wire):
+    async def classic(update_id, message):
+        return await plugin._relay_owner_message(api, wire, message, update_id, message.get("text", ""), "", "en")
+    return classic
+
+
+def _receive(env, message, update_id):
+    asyncio.run(env.plugin._handle_owner_message(env.api, env.wire, {"message": message}, update_id,
+                                                 "full_access", "en"))
+
+
+def _custody(env, sql, args=()):
+    return env.tp._rows(env.api, sql, args)
+
+
+async def _drain(env, until, *, timeout=15.0):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        await env.runner.tick()
+        if until():
+            return
+        await asyncio.sleep(0.05)
+    facts = {table: _custody(env, f"SELECT * FROM {table}") for table in ("inbox", "work", "outbox", "reports", "gaps")}
+    raise AssertionError(f"runner did not reach the expected state: {facts} logs={env.api.logs}")
+
+
+def _run(env, until, timeout=15.0):
+    async def go():
+        try:
+            await _drain(env, until, timeout=timeout)
+        finally:
+            await env.runner.stop()
+    asyncio.run(go())
+
+
+async def _wait(condition, timeout=15.0):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if condition():
+            return
+        await asyncio.sleep(0.05)
+    raise AssertionError("condition not reached")
+
+
+def _chat_rows(root):
+    from ouroboros import dialogue_store
+    return [entry.row for entry in dialogue_store.iter_rows(root, "chat")]
+
+
+def _poll(update_id, message=None, **kind):
+    return {"update_id": update_id, **({"message": message} if message else {}), **kind}
+
+
+def _ctx(task_id, task=None):
+    return SimpleNamespace(task_id=task_id, task_metadata=(task or {}).get("metadata") or {},
+                           task_contract=(task or {}).get("task_contract") or {}, task_depth=0)
+
+
+def _tool(env, name, ctx, **args):
+    handler, _spec = env.api.tools[name]
+    result = handler(ctx, **args)
+    return json.loads(asyncio.run(result) if asyncio.iscoroutine(result) else result)
+
