+    monkeypatch.setattr(message_bus, "DATA_DIR", env.root)
+    published = []
+    for topic in ("chat.outbound", "chat.photo", "chat.video", "chat.document"):
+        bus.subscribe("telegram", topic, lambda e, topic=topic: published.append((topic, e)))
+    bridge = message_bus.LocalChatBridge({})
+    monkeypatch.setattr(message_bus, "_BRIDGE", bridge)
+    write_task_result(env.root, "bench-root", "running", metadata={})
+    write_task_result(env.root, "bench-child", "running", metadata={"parent_task_id": "bench-root",
+                                                                    "delegation_role": "subagent"})
+    # The production send seam: the row is written first and its address rides the event.
+    message_bus.send_with_budget(project["chat_id"], "Run 3 finished: 71%", task_id="bench-root")
+    message_bus.send_with_budget(project["chat_id"], "child chatter", task_id="bench-child",
+                                 progress_meta={"delegation_role": "subagent", "parent_task_id": "bench-root"})
+    bridge.send_photo(OWNER, b"\x89PNG", caption="child plot", task_id="bench-child")
+    bridge.send_video(OWNER, b"video", caption="child video", task_id="bench-child")
+    bridge.send_document(OWNER, b"doc", filename="child.txt", task_id="bench-child")
+    bridge.send_photo(OWNER, b"\x89PNG", caption="root plot", task_id="main-1")
+    handlers = {"chat.outbound": env.plugin._make_outbound(env.api), "chat.photo": env.plugin._make_photo(env.api),
+                "chat.video": env.plugin._make_video(env.api), "chat.document": env.plugin._make_document(env.api)}
+    for topic, event in published:
+        asyncio.run(handlers[topic](event))
+    media = [(topic, e.get("task_id")) for topic, e in published if topic != "chat.outbound"]
+    assert media == [("chat.photo", "bench-child"), ("chat.video", "bench-child"), ("chat.document", "bench-child"),
+                     ("chat.photo", "main-1")], "the real emitter now names each media producer"
+    sent_media = [(m, d.get("caption") or d.get("filename")) for m, d in env.wire.calls
+                  if m in {"sendPhoto", "sendVideo", "sendDocument"}]
+    assert sent_media == [("sendPhoto", "root plot")], "a delegated child's media stays with its root"
