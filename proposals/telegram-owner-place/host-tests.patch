+++ b/tests/test_telegram_handoff_routing.py
@@ -0,0 +1,356 @@
+"""Telegram ``hand_to_main`` one level past the Host's accepted row: Main's routing acts on it.
+
+The owner writes in a connected Telegram place; the place focus hands the exact words to Main; the
+supervisor intake consumes them; Main's routing decision calls a real tool on existing Project work.
+
+Real: the Host Service app and its ``/chat/inject`` acceptance (the canonical owner row), the skill's
+place runner, focus custody and ``hand_to_main`` tool (``env`` from ``tests.test_telegram_places``), a
+real ``LocalChatBridge`` inbox, the supervisor intake ``server._process_bridge_updates`` with
+``_route_owner_message`` and ``_decision_turn_metadata``, the tool functions ``tell_task``,
+``resume_task`` and ``continue_task``, ``supervisor.events.dispatch_event`` into steering, mind
+controls, the owner Pause fence, the queue and continuation admission, the owner mailbox,
+``send_with_budget`` -> ``LocalChatBridge.send_message`` -> ``chat.outbound``, the skill's outbound
+handler and its place runner/outbox.
+
+Doubles: the place mind (``env``'s scripted ``Model``); the Main routing model (``MainTurn``: it
+stands where the intake calls ``handle_chat_direct``, builds the direct turn's ``ToolContext`` from
+the metadata routing produced, and a scripted choice calls one real tool; ``LLMClient`` raises); the
+Telegram wire; the Host's Panic door and decision ingress (``env``'s recorded ``host_post``); and a
+thread that runs at once.
+"""
+from __future__ import annotations
+
+import asyncio
+import copy
+import json
+import sys
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from ouroboros.task_results import load_task_result, write_task_result
+from ouroboros.tool_call_log import invocation_scope
+from tests._budget_pause_exact_helpers import _install_queue
+from tests.test_project_routing_v664 import _ImmediateThread
+from tests import test_telegram_places as places_suite
+from tests.test_telegram_places import OWNER, _ctx, _message, _poll, _receive, _run, _tool, _wait
+
+pytestmark = pytest.mark.serial
+env = places_suite.env  # the shared place fixture: Host app, place, scripted focus, recorded wire
+
+FOCUS_REPLY = "Passed to Main."
+
+
+class MainTurn:
+    """Main's routing turn with the model replaced by ``choose(ctx)``.
+
+    Called exactly where the real intake calls ``ctx.handle_chat_direct``. The tool context carries
+    the routing metadata as given; its event queue is the real supervisor dispatch. ``meanwhile``
+    runs while the turn is still undecided; ``reply`` is then sent through the real send seam.
+    """
+
+    def __init__(self, root):
+        self.root, self.sup = root, None
+        self.calls, self.events, self.results = [], [], []
+        self.choose, self.reply, self.meanwhile = None, "", None
+
+    def __call__(self, chat_id, text, image_data=None, *, task_constraint=None, task_metadata=None):
+        from ouroboros.tools.registry import ToolContext
+        from supervisor import message_bus
+        from supervisor.events import dispatch_event
+
+        turn = f"main-turn-{len(self.calls) + 1}"
+        self.calls.append({"turn": turn, "chat_id": chat_id, "text": text, "image_data": image_data,
+                           "metadata": copy.deepcopy(task_metadata)})
+
+        def emit(event):
+            self.events.append(copy.deepcopy(event))
+            dispatch_event(event, self.sup)
+
+        ctx = ToolContext(repo_dir=self.root, drive_root=self.root, task_id=turn, current_chat_id=chat_id,
+                          task_metadata=dict(task_metadata or {}), is_direct_chat=True,
+                          event_queue=SimpleNamespace(put_nowait=emit))
+        if self.meanwhile is not None:
+            self.meanwhile()
+        with invocation_scope({"tool_call_id": f"{turn}:call-1"}):
+            self.results.append(self.choose(ctx))
+        if self.reply:
+            message_bus.send_with_budget(chat_id, self.reply, task_id=turn)
+
+
+@pytest.fixture
+def main(env, monkeypatch):
+    """Supervisor queue/state, one Project, a real bridge behind the Host, and Main's scripted turn."""
+    from ouroboros import event_bus, projects_registry
+    from ouroboros.llm import LLMClient
+    from ouroboros.utils import append_jsonl
+    from supervisor import message_bus
+
+    root = env.root
+    queue, _state, workers = _install_queue(root, monkeypatch)
+    monkeypatch.setattr(message_bus, "DATA_DIR", root)
+    bridge = message_bus.LocalChatBridge()
+    frames = []
+    bridge._broadcast_fn = frames.append
+    monkeypatch.setattr(message_bus, "_BRIDGE", bridge)
+    env.app.state.host_service_context.bridge_getter = lambda: bridge  # the Host now feeds the real inbox
+    bus = event_bus.EventBus()
+    monkeypatch.setattr(event_bus, "_GLOBAL_BUS", bus)
+    outbound = []
+    bus.subscribe("telegram", "chat.outbound", outbound.append)
+
+    def no_model(*_args, **_kwargs):
+        raise AssertionError("no model call: Main's routing choice is scripted")
+
+    async def no_model_async(*_args, **_kwargs):
+        no_model()
+
+    monkeypatch.setattr(LLMClient, "chat", no_model)
+    monkeypatch.setattr(LLMClient, "chat_async", no_model_async)
+    monkeypatch.setattr("ouroboros.server_owner_routing.threading", SimpleNamespace(Thread=_ImmediateThread))
+    settings = env.api.state_dir / "settings.json"
+    settings.write_text(json.dumps({**json.loads(settings.read_text(encoding="utf-8")),
+                                    "TELEGRAM_MIRROR_MODE": "main"}), encoding="utf-8")
+    project = projects_registry.create_project(root, "bench", name="Benchmarks")
+    turn = MainTurn(root)
+    live = {"owner_id": 1, "owner_chat_id": 1}
+    turn.sup = SimpleNamespace(
+        DRIVE_ROOT=root, PENDING=workers.PENDING, RUNNING=workers.RUNNING, WORKERS=workers.WORKERS,
+        BUDGET_ROOT_FENCES=queue.BUDGET_ROOT_FENCES, bridge=bridge, handle_chat_direct=turn,
+        load_state=lambda: dict(live), update_state=lambda fn: (fn(live), live)[1],
+        consciousness=SimpleNamespace(inject_observation=lambda *_: None, pause=lambda: None, resume=lambda: None),
+        get_chat_agent=lambda: SimpleNamespace(_busy=False), send_with_budget=message_bus.send_with_budget,
+        append_jsonl=append_jsonl, persist_queue_snapshot=queue.persist_queue_snapshot, sort_pending=lambda: None,
+        kill_workers=lambda *_a, **_k: None)
+    return SimpleNamespace(root=root, bridge=bridge, frames=frames, outbound=outbound, turn=turn, workers=workers,
+                           queue=queue, project=project, chat=int(project["chat_id"]), pid=str(project["id"]),
+                           settings=settings)
+
+
+def _project_task(main, task_id, **fields):
+    return {"id": task_id, "type": "task", "root_task_id": task_id, "chat_id": main.chat, "project_id": main.pid,
+            "title": "Bench run", "text": "Run the bench suite", **fields}
+
+
+def _hand_off(env, main, words, mid, update_id):
+    """The owner writes in the place chat, the focus hands it to Main, the supervisor intake consumes it."""
+    import server
+    from supervisor.message_ingress import accepted_chat_message
+
+    handed = []
+
+    def during(task):
+        if task["metadata"]["presence"]["observed_text"] == words:
+            handed.append(_tool(env, "hand_to_main", _ctx(task["id"], task)))
+
+    env.model.during, env.model.reply = during, FOCUS_REPLY
+    _receive(env, _message(mid, words), update_id)
+    _run(env, lambda: handed and any(FOCUS_REPLY in d["text"] for d in env.wire.sent()))
+    client_id = f"tg:{OWNER}:{mid}"
+    assert handed[0]["ok"] and handed[0]["client_message_id"] == client_id, handed
+    row = accepted_chat_message(env.root, OWNER, client_id)
+    assert row and row["text"] == words and row["source"] == "skill:telegram"
+    assert row["transport"]["kind"] == "telegram" and main.turn.calls == [], "routing is still pending"
+    server._process_bridge_updates(main.bridge, 0, main.turn.sup, timeout=1)
+    assert main.bridge.get_updates(offset=0, timeout=0) == [], "consumed once, nothing handed back"
+    [call] = main.turn.calls
+    assert (call["chat_id"], call["text"], call["image_data"]) == (OWNER, words, None), "the owner's words only"
+    metadata = call["metadata"]
+    assert metadata["origin_message_ref"]["client_message_id"] == client_id and metadata["work_kind"] == "owner"
+    assert metadata["routing_contract"]["source_lane"] == "main"
+    assert main.pid in [p["project_id"] for p in metadata["main_routing_manifest"]["projects"]]
+    assert not _handler_errors(env.root)
+    return row, call
+
+
+def _handler_errors(root):
+    path = root / "logs" / "supervisor.jsonl"
+    rows = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line] if path.exists() else []
+    return [r for r in rows if r.get("type") in {"worker_event_handler_error", "unknown_worker_event"}]
+
+
+def _mind_outcome(root, turn):
+    """The supervisor's control outcome, as the deciding turn reads it from its own mailbox."""
+    from ouroboros.owner_mailbox import drain_owner_entries
+
+    [entry] = drain_owner_entries(root, turn)
+    assert entry["kind"] == "task_message" and entry["provenance"] == "system"
+    return json.loads(entry["text"])
+
+
+def _mirror(env, main, turn, reply):
+    """Every published ``chat.outbound`` through the skill's real handler, then a place runner turn."""
+    from ouroboros.places import conversation_chat_id
+
+    handler = env.plugin._make_outbound(env.api)
+    for event in list(main.outbound):
+        asyncio.run(handler(event))
+    _run(env, lambda: True)  # the place runner and outbox get their turn after the mirror
+    texts = [d["text"] for d in env.wire.sent() if d["chat_id"] == str(OWNER)]
+    assert sum(reply in text for text in texts) == 1, texts
+    [event] = [e for e in main.outbound if e.get("text") == reply]
+    assert event["chat_id"] == OWNER and event["transport"]["kind"] == "telegram" and event["task_id"] == turn
+    assert not env.tp.room_event(env.api, event), "Main's chat is not a place room"
+    room = env.model.tasks[-1]["metadata"]["presence"]["event"]["conversation_key"]
+    assert env.tp.room_event(env.api, {"chat_id": conversation_chat_id(room)}), "the exclusion covers rooms only"
+    outbox = env.tp._rows(env.api, "SELECT task_id, state FROM outbox", ())
+    assert outbox and {r["state"] for r in outbox} == {"done"} and turn not in {r["task_id"] for r in outbox}, \
+        "the place outbox holds only the focus's own reply, never Main's"
+    assert not [m for _level, m in env.api.logs if "outbound error" in m]
+    return texts
+
+
+# ---- RUNNING: tell_task -> steering -> the running task's mailbox ----------------------------------
+
+@pytest.mark.parametrize("mirror_mode", ["main", "all"])
+def test_running_project_work_gets_a_relay_of_the_owners_exact_telegram_words(env, main, mirror_mode):
+    from ouroboros.owner_mailbox import drain_owner_entries
+    from ouroboros.owner_relay import held_owner_messages
+    from ouroboros.project_dialogue import latest_chat_annotations
+    from ouroboros.tools.control_relay import _tell_task
+
+    words = "Tell the bench run to stop after this epoch"
+    note = "Owner relay: stop the bench run at the next epoch boundary."
+    main.settings.write_text(json.dumps({**json.loads(main.settings.read_text(encoding="utf-8")),
+                                         "TELEGRAM_MIRROR_MODE": mirror_mode}), encoding="utf-8")
+    task = _project_task(main, "bench-run", drive_root=str(main.root))
+    main.workers.RUNNING["bench-run"] = {"task": task, "started_at": time.time()}
+    write_task_result(main.root, "bench-run", "running", chat_id=main.chat, project_id=main.pid,
+                      root_task_id="bench-run")
+    held = {}
+
+    def choose(ctx):
+        held.update(held_owner_messages(ctx))
+        return _tell_task(ctx, "bench-run", note=note, quote=list(held))
+
+    main.turn.choose, main.turn.reply = choose, "Told the bench run to stop after this epoch."
+    row, call = _hand_off(env, main, words, 50, 7)
+    client_id = row["client_message_id"]
+
+    assert [r["client_message_id"] for r in held.values()] == [client_id], "Main holds only the accepted row"
+    assert main.turn.results == ["Message written to bench-run; relay_id=" + main.turn.events[0]["relay_id"]
+                                 + ". Read acknowledgement follows when it drains."]
+    [relay] = drain_owner_entries(main.root, "bench-run")
+    assert relay["kind"] == "relay_entry" and relay["text"] == note, "the model's note keeps its own voice"
+    [quote] = relay["relay"]["quotes"]
+    assert quote["text"] == words, "the quote is the owner's exact words, not the note"
+    assert quote["source"]["client_message_id"] == client_id and quote["source"]["chat_id"] == OWNER
+    assert [r["client_message_id"] for r in relay["owner_rows"]] == [client_id]
+    assert relay["owner_rows"][0]["text"] == row["text"] and relay["owner_rows"][0]["ts"] == row["ts"]
+    [steer] = main.turn.events
+    assert steer["type"] == "steer_task" and steer["client_message_id"] == client_id, "attributed, not invented"
+    assert steer["issuer"]["kind"] == "owner_turn" and steer["chat_id"] == OWNER
+    receipt = latest_chat_annotations(main.root)[client_id]
+    assert (receipt["action"], receipt["target"], receipt["status"]) == ("steer_task", "bench-run", "delivered")
+    texts = _mirror(env, main, call["turn"], main.turn.reply)
+    if mirror_mode == "main":
+        assert not any(words in text for text in texts), "the owner's own words are never mirrored back"
+
+
+# ---- PAUSED: resume_task -> handle_mind_task_control -> the queue --------------------------------
+
+def test_paused_project_work_is_resumed_through_the_real_queue_while_fast_controls_stay_live(env, main):
+    """Also (5): while Main's turn is still undecided, the poller serves /panic and a quiz tap at once."""
+    from ouroboros.owner_pause import fence_closed, read_fence
+    from ouroboros.room_reader import is_reading
+    from ouroboros.tools.control_mind import _resume_task
+    from supervisor.owner_pause_control import request_owner_pause
+
+    task = _project_task(main, "bench-paused", _attempt=1, admitted_dispatch="none")
+    main.workers.PENDING.append(task)
+    write_task_result(main.root, "bench-paused", "scheduled", chat_id=main.chat, project_id=main.pid,
+                      root_task_id="bench-paused")
+    assert request_owner_pause("bench-paused", request_id="owner-pause")["ok"]
+    assert fence_closed(read_fence(main.root, "bench-paused"))
+    assert not is_reading(main.root, "bench-paused", task, running=True)
+    reason = "The owner asked in Telegram to resume the bench run."
+    served = {}
+    main.turn.choose = lambda ctx: json.loads(_resume_task(ctx, "bench-paused", reason))
+    main.turn.reply = "Resumed the bench run."
+    main.turn.meanwhile = lambda: served.update(_fast_controls(env))
+    row, call = _hand_off(env, main, "Resume the paused bench run", 51, 8)
+
+    assert served == {"panic": 1, "quiz": 1}, "fast controls did not wait for Main's routing"
+    assert main.turn.results[0]["status"] == "requested" and main.turn.results[0]["transport"] == "live"
+    [control] = main.turn.events
+    assert (control["type"], control["action"], control["actor_task_id"]) == (
+        "mind_task_control", "resume_task", call["turn"])
+    outcome = _mind_outcome(main.root, call["turn"])
+    assert outcome["outcome"]["ok"], outcome
+    fence = read_fence(main.root, "bench-paused")
+    assert not fence_closed(fence) and fence["resume_actor"]["task_id"] == call["turn"]
+    [queued] = [t for t in main.workers.PENDING if t["id"] == "bench-paused"]
+    assert not queued.get("_owner_hold") and not main.workers.RUNNING
+    assert is_reading(main.root, "bench-paused", queued, running=True), "the resumed root reads its room again"
+    _mirror(env, main, call["turn"], main.turn.reply)
+
+
+def _fast_controls(env):
+    """One poller pass over an owner /panic and a quiz tap; returns what reached the Host's doors."""
+    quiz = sys.modules[env.plugin.__package__ + ".lib.telegram_quiz"]
+    token = quiz.mint_token("asker", "q-tap")
+    quiz.remember_quiz(env.api, token, {"task_id": "asker", "quiz_id": "q-tap", "chat_id": OWNER, "message_id": 300,
+                                        "options": ["Yes", "No"], "text": "Proceed?"})
+    tap = {"id": "cb1", "data": f"qz:{token}:0", "from": {"id": OWNER},
+           "message": {"message_id": 300, "chat": {"id": OWNER, "type": "private"}}}
+    env.wire.updates.append([_poll(20, _message(60, "/panic")), _poll(21, callback_query=tap)])
+
+    def counts():
+        return {"panic": [p.get("text") for path, p in env.injects if path == "/chat/inject"].count("/panic"),
+                "quiz": [path for path, _p in env.injects].count("/chat/decision")}
+
+    async def scenario():
+        poller = asyncio.create_task(env.plugin._poller(env.api))
+        try:
+            await _wait(lambda: counts() == {"panic": 1, "quiz": 1})
+        finally:
+            poller.cancel()
+            await asyncio.gather(poller, return_exceptions=True)
+
+    asyncio.run(scenario())
+    return counts()
+
+
+# ---- ENDED: continue_task -> admit_continuation -> one successor ---------------------------------
+
+def test_ended_project_work_gets_one_successor_attributed_to_the_routed_owner_turn(env, main):
+    from ouroboros.task_results import STATUS_CANCELLED, STATUS_RUNNING
+    from ouroboros.tools.control_mind import _continue_task
+
+    write_task_result(main.root, "bench-ended", STATUS_RUNNING, chat_id=main.chat, project_id=main.pid,
+                      root_task_id="bench-ended", title="Bench run", deadline_at="2099-01-01T00:00:00+00:00",
+                      origin_message_text="Run the bench suite",
+                      origin_message_ref={"chat_id": main.chat, "client_message_id": "bench-origin"},
+                      billing_group={"billing_group_id": "bench-ended", "billing_group_limit_usd": 20.0,
+                                     "billing_group_limit_source": "initial_task_admission",
+                                     "billing_group_limit_revision": "admission-1"})
+    write_task_result(main.root, "bench-ended", STATUS_CANCELLED, result="interrupted",
+                      cancel_origin={"source": "snapshot_restore", "reason": "server_shutdown"})
+    reason = "The owner asked in Telegram to continue the interrupted bench run."
+    main.turn.choose = lambda ctx: json.loads(_continue_task(ctx, "bench-ended", reason))
+    main.turn.reply = "Continuing the bench run."
+    row, call = _hand_off(env, main, "Continue the interrupted bench run", 52, 9)
+
+    [control] = main.turn.events
+    assert (control["action"], control["task_id"], control["actor_task_id"]) == (
+        "continue_task", "bench-ended", call["turn"])
+    outcome = _mind_outcome(main.root, call["turn"])["outcome"]
+    assert outcome["ok"] and outcome["replay"] is False, outcome
+    successor = outcome["successor_task_id"]
+    [admitted] = [t for t in main.workers.PENDING if t["id"] == successor]
+    assert successor.startswith("bench-ended-c") and admitted["predecessor_task_id"] == "bench-ended"
+    assert (admitted["chat_id"], admitted["project_id"]) == (main.chat, main.pid), "it stays Project work"
+    claim = load_task_result(main.root, "bench-ended")["continued_by"]
+    assert claim["successor_task_id"] == successor
+    assert claim["by"]["actor"] == "ouroboros" and claim["by"]["task_id"] == call["turn"]
+    assert claim["by"]["text"] == reason
+    stored = load_task_result(main.root, successor)
+    assert stored["status"] == "scheduled" and stored["continuation_admission"]["by"]["task_id"] == call["turn"]
+    assert call["metadata"]["origin_message_ref"]["client_message_id"] == row["client_message_id"], \
+        "the turn credited with the Continue is the one routing started for the accepted Telegram row"
+    from supervisor.events import dispatch_event
+
+    dispatch_event(copy.deepcopy(control), main.turn.sup)  # a redelivered control reuses its one successor
+    assert [t["id"] for t in main.workers.PENDING] == [successor] and not _handler_errors(main.root)
+    _mirror(env, main, call["turn"], main.turn.reply)
