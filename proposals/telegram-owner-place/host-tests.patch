+    project = projects_registry.create_project(env.root, "bench", name="Benchmarks")
+    bus = event_bus.EventBus()
+    monkeypatch.setattr(event_bus, "_GLOBAL_BUS", bus)
+    monkeypatch.setattr(message_bus, "DATA_DIR", env.root)
+    bridge = message_bus.LocalChatBridge({})
+    monkeypatch.setattr(message_bus, "_BRIDGE", bridge)
+    published = []
+    for topic in ("chat.outbound", "chat.document", "chat.links"):
+        bus.subscribe("telegram", topic, lambda e, topic=topic: published.append((topic, e)))
+    for task_id, meta in (("main-1", {}), ("bench-root", {}),
+                          ("bench-child", {"parent_task_id": "bench-root", "delegation_role": "subagent"})):
+        write_task_result(env.root, task_id, "running", metadata=meta)
+    telegram = {"kind": "telegram", "conversation_id": str(OWNER)}
+    # A Project whose work began from Telegram keeps that reply transport on its own room.
+    bridge.activate_update_transport({"chat_id": project["chat_id"], "transport": telegram})
+    bridge.activate_update_transport({"chat_id": OWNER, "transport": telegram})
+    message_bus.send_with_budget(project["chat_id"], "Raw row of a Telegram-born project", task_id="bench-root")
+    bridge.send_document(project["chat_id"], b"x", filename="project.csv", task_id="bench-root")
+    message_bus.send_with_budget(1, "Benchmarks finished", task_id="bench-root", role="system",
+                                 system_type="project_completion_summary",
+                                 progress_meta={"completion_notice": {"neutral": False, "detail": "Run 4 finished",
+                                                                      "phase": "done"}, "target_label": "Benchmarks"})
+    message_bus.send_with_budget(1, "Benchmarks needs your decision on run 5.", task_id="bench-root",
+                                 system_type="main_notice")
+    message_bus.send_with_budget(OWNER, "Answer to your Telegram request", task_id="main-1")
+    bridge.send_links(1, [{"label": "Report", "url": "https://example.com/report"}], title="Root links", task_id="main-1")
+    bridge.send_links(1, [{"label": "Scratch", "url": "https://example.com/scratch"}], title="Child links",
+                      task_id="bench-child")
+    links = [e for topic, e in published if topic == "chat.links"]
+    assert [e["task_id"] for e in links] == ["main-1", "bench-child"] and all(e.get("row_address") for e in links), \
+        "the real links emitter now names its producer"
+
+    def deliver(mode):
+        settings = {"TELEGRAM_CHAT_ID": str(OWNER), "TELEGRAM_ORDINARY_CHAT": "place", "TELEGRAM_MIRROR_MODE": mode,
+                    "TELEGRAM_NOTIFY_TASKS": "on"}
+        (env.api.state_dir / "settings.json").write_text(json.dumps(settings), encoding="utf-8")
+        env.wire.calls.clear()
+        handlers = {"chat.outbound": env.plugin._make_outbound(env.api), "chat.document": env.plugin._make_document(env.api),
+                    "chat.links": env.plugin._make_links(env.api)}
+        for topic, event in published:
+            asyncio.run(handlers[topic](event))
+        return ([d["text"] for d in env.wire.sent()],
+                [d.get("filename") for m, d in env.wire.calls if m == "sendDocument"])
+
+    texts, files = deliver("main")
+    assert texts.count("Answer to your Telegram request") == 1, "a handoff answer in the owner's chat still goes"
+    assert texts.count("Benchmarks needs your decision on run 5.") == 1, "a deliberate Main notice is Main speech"
+    assert texts.count("Root links") == 1
+    for absent in ("Raw row of a Telegram-born project", "Benchmarks finished", "Run 4 finished", "Child links"):
+        assert not any(absent in t for t in texts), (absent, texts)
+    assert files == [], "a Project room's file never mirrors, whatever transport its room kept"
+    classic_texts, classic_files = deliver("all")  # the classic mode is unchanged: it still mirrors them
+    assert "Raw row of a Telegram-born project" in classic_texts and "Child links" in classic_texts
+    assert any("Run 4 finished" in t for t in classic_texts) and classic_files == ["project.csv"]
+
