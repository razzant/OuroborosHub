+def _confinement_faults(path: Path, folder: Path) -> list[str]:
+    """Why writing ``path`` would not be one plain file of ``folder`` on Windows or POSIX."""
+    leaf, faults = path.name, []
+    windows = PureWindowsPath(leaf)
+    if path.parent != folder:
+        faults.append("outside its staging folder")
+    if not windows.name == leaf == PurePosixPath(leaf).name or windows.anchor or leaf in {"", ".", ".."}:
+        faults.append("not one plain component")
+    if ":" in leaf:
+        faults.append("drive or stream")
+    if windows.stem.upper() in _DEVICE_NAMES:
+        faults.append("device name")
+    return faults
+
+
+def _stage_guarded(env, monkeypatch, update_id, message):
+    """``stage_files`` with every write checked BEFORE it happens: a name that would leave the
+    private staging file (drive, share, traversal, stream, device) is refused unwritten, so this
+    is safe against unfixed code on Windows too; a confined write still really happens."""
+    folder, real_write, attempts = env.api.state_dir / "places_staging" / str(update_id), Path.write_bytes, []
+
+    def write_bytes(self, data):
+        attempts.append(self)
+        faults = _confinement_faults(self, folder)
+        assert not faults, f"refused before writing {str(self)!r}: {faults}"
+        return real_write(self, data)
+
+    with monkeypatch.context() as guarded:
+        guarded.setattr(Path, "write_bytes", write_bytes)
+        staged = asyncio.run(env.tp.stage_files(env.api, lambda: env.wire, update_id, message))
+    assert attempts == [Path(staged[0]["path"])] and attempts[0].read_bytes() == b"file bytes"
+    return folder, staged
+
