+def _dispatch(env, task, short, **args):
+    """One production dispatch: a real ToolContext for the host's own task record."""
+    registry = ToolRegistry(repo_dir=env.root, drive_root=env.root)
+    registry.set_context(ToolContext(repo_dir=env.root, drive_root=env.root, budget_drive_root=str(env.root),
+                                     task_id=task["id"], task_metadata=task["metadata"],
+                                     current_chat_id=task.get("chat_id")))
+    return registry.execute_result(_name(short), args)
+
