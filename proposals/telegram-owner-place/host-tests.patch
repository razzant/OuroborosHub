+"""Telegram mode selection through the real Settings SPA and settings writer.
+
+The server is an isolated candidate. Its extension inventory is a fixture built
+by the production Telegram register() call and the production settings-schema
+validator; pollers and the Mini App companion are not started. Browser form
+requests invoke the production settings handler against private state. This
+proves rendering/hydration/save/return, not a live bot, extension startup,
+native picker popups or Place activation.
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import pytest
+from starlette.requests import Request
+
+from ouroboros.extension_ui_validation import validate_settings_schema
+from tests.test_telegram_format_parity import _load_skill
+from tests.test_ui_smoke_playwright import direct_server_with_data as direct_server_with_data
+
+
+class SettingsCapture:
+    def __init__(self, root):
+        self.root = root
+        self.sections = []
+        self.routes = {}
+
+    def get_state_dir(self):
+        return str(self.root)
+
+    def get_runtime_info(self):
+        return {"data_dir": str(self.root / "host")}
+
+    def get_settings(self, _keys):
+        return {}
+
+    def log(self, *_args):
+        pass
+
+    def register_supervised_task(self, *_args, **_kwargs):
+        pass
+
+    def subscribe_event(self, *_args, **_kwargs):
+        pass
+
+    def register_tool(self, *_args, **_kwargs):
+        pass
+
+    def register_route(self, name, handler, **_kwargs):
+        self.routes[name] = handler
+
+    def register_settings_section(self, section_id, *, title, schema):
+        # The same validated render production registration serves.
+        self.sections.append({"key": f"telegram:{section_id}", "skill": "telegram", "section_id": section_id,
+                              "title": title, "render": validate_settings_schema(schema)})
+
+
+@pytest.mark.ui_browser
+@pytest.mark.serial
+def test_telegram_place_modes_hydrate_save_and_return_in_settings(direct_server_with_data, tmp_path, monkeypatch):
+    from playwright.sync_api import expect, sync_playwright
+
+    plugin, _ = _load_skill()
+    api = SettingsCapture(tmp_path / "telegram-state")
+    api.root.mkdir()
+    baseline = {"TELEGRAM_CHAT_ID": "42", "TELEGRAM_MIRROR_MODE": "telegram_only",
+                "TELEGRAM_ORDINARY_CHAT": "main", "TELEGRAM_SUBAGENT_CARDS": "off",
+                "TELEGRAM_MINIAPP_ENABLED": "off", "fixture_keep": "preserved"}
+    state = api.root / "settings.json"
+    state.write_text(json.dumps(baseline), encoding="utf-8")
+    monkeypatch.setattr(plugin, "register_miniapp", lambda _api: None)
+    plugin.register(api)
+    assert len(api.sections) == 1
+    writes, requests = [], []
+
+    def inventory(route):
+        response = route.fetch()
+        data = response.json()
+        data.setdefault("live", {})["settings_sections"] = api.sections
+        route.fulfill(response=response, json=data)
+
+    def form_route(route):
+        method = route.request.method
+        body = route.request.post_data_json if method == "POST" else {}
+
+        async def run_handler():
+            async def receive():
+                return {"type": "http.request", "body": json.dumps(body).encode(), "more_body": False}
+
+            request = Request({"type": "http", "method": method, "headers": [],
+                               "client": ("127.0.0.1", 10000)}, receive)
+            return await api.routes["settings/save"](request)
+
+        # Playwright's sync dispatcher owns this thread's running loop.
+        with ThreadPoolExecutor(1) as pool:
+            result = pool.submit(asyncio.run, run_handler()).result(timeout=30)
+        requests.append({"method": method, "status": result.status_code})
+        if method == "POST":
+            writes.append({"request": body, "status": result.status_code})
+        route.fulfill(status=result.status_code, content_type="application/json", body=result.body)
+
+    output = Path(os.environ.get("OUROBOROS_UI_EVIDENCE_OUT") or tmp_path / "screenshots")
+    output.mkdir(parents=True, exist_ok=True)
+    observations = []
+    candidate = direct_server_with_data["repo_dir"]
+    sources = {name: hashlib.sha256((candidate / name).read_bytes()).hexdigest() for name in (
+        "skills/telegram/plugin.py", "skills/telegram/scripts/telegram_settings.py", "web/modules/settings.js",
+        "ouroboros/extension_ui_validation.py", "tests/test_telegram_place_settings_browser.py")}
+    try:
+        with sync_playwright() as pw:
+            for engine, width, height in (("chromium", 1512, 949), ("webkit", 1512, 949), ("webkit", 390, 844)):
+                browser = getattr(pw, engine).launch(headless=True)
+                try:
+                    page = browser.new_page(viewport={"width": width, "height": height})
+                    errors, console_errors, failed_responses = [], [], []
+                    page.on("pageerror", lambda error: errors.append(str(error)))
+                    page.on("console", lambda msg: console_errors.append(msg.text) if msg.type == "error" else None)
+                    page.on("response", lambda r: failed_responses.append(f"{r.status} {r.request.method} {r.url}")
+                            if r.status >= 400 else None)
+                    page.route("**/api/extensions", inventory)
+                    page.route("**/api/extensions/telegram/settings/save", form_route)
+                    page.goto(direct_server_with_data["url"] + "/#settings", wait_until="domcontentloaded")
+                    page.wait_for_selector("#page-settings", timeout=30000)
+                    page.locator('[data-settings-tab="advanced"]').click()
+                    form = page.locator('[data-extension-settings-form][data-skill="telegram"][data-route="settings/save"]')
+                    ordinary = form.locator('[name="TELEGRAM_ORDINARY_CHAT"]')
+                    mirror = form.locator('[name="TELEGRAM_MIRROR_MODE"]')
+                    expect(ordinary).to_have_value("main", timeout=30000)
+                    expect(mirror).to_have_value("telegram_only")
+                    ordinary.select_option("place")
+                    mirror.select_option("main")
+                    form.get_by_role("button", name="Save Telegram settings", exact=True).click()
+                    expect(form.locator("[data-extension-settings-status]")).to_contain_text("saved", timeout=10000)
+                    saved = json.loads(state.read_text(encoding="utf-8"))
+                    assert saved["TELEGRAM_ORDINARY_CHAT"] == "place" and saved["TELEGRAM_MIRROR_MODE"] == "main"
+                    assert saved["TELEGRAM_CHAT_ID"] == "42" and saved["fixture_keep"] == "preserved"
+                    assert saved["TELEGRAM_MINIAPP_ENABLED"] == "off" and saved["TELEGRAM_SUBAGENT_CARDS"] == "off"
+                    for theme in ("light", "dark"):
+                        page.evaluate("theme => { localStorage.setItem('ouroboros.theme', theme); }", theme)
+                        page.reload(wait_until="domcontentloaded")
+                        page.wait_for_selector("#page-settings", timeout=30000)
+                        page.locator('[data-settings-tab="advanced"]').click()
+                        expect(ordinary).to_have_value("place", timeout=30000)
+                        expect(mirror).to_have_value("main")
+                        ordinary.evaluate("el => el.scrollIntoView({block: 'center'})")
+                        page.evaluate("() => new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)))")
+                        facts = form.evaluate("""el => ({width: el.clientWidth, scroll: el.scrollWidth,
+                            viewport: document.documentElement.clientWidth, page_scroll: document.documentElement.scrollWidth,
+                            painted_theme: document.documentElement.dataset.theme || '',
+                            fields: [...el.querySelectorAll('select')].map(x => {
+                                const box = x.getBoundingClientRect(), field = x.closest('.ui-field');
+                                return {name: x.name, value: x.value, label: field?.querySelector(':scope > span')?.textContent.trim() || '',
+                                        selected: x.selectedOptions[0]?.textContent || '', left: box.left, right: box.right,
+                                        width: box.width, height: box.height,
+                                        help: field?.querySelector('.ui-field-help')?.textContent.trim() || ''};
+                            })})""")
+                        assert facts["scroll"] <= facts["width"] + 1, facts
+                        # The 390px risk: a long native option label must not push its select off-screen.
+                        assert all(0 <= x["left"] and x["right"] <= facts["viewport"] + 1 for x in facts["fields"]), facts
+                        stem = f"telegram-settings-{engine}-{width}-{theme}"
+                        page.screenshot(path=str(output / f"{stem}.png"))
+                        form.screenshot(path=str(output / f"{stem}-form.png"))
+                        observations.append({"engine": engine, "browser_version": browser.version,
+                                             "viewport": [width, height], "theme": theme,
+                                             "screenshots": [f"{stem}.png", f"{stem}-form.png"], **facts})
+                    ordinary.select_option("main")
+                    mirror.select_option("telegram_only")
+                    form.get_by_role("button", name="Save Telegram settings", exact=True).click()
+                    expect(form.locator("[data-extension-settings-status]")).to_contain_text("saved")
+                    restored = json.loads(state.read_text(encoding="utf-8"))
+                    assert all(restored[key] == value for key, value in baseline.items())
+                    assert not errors, errors
+                    observations.append({"engine": engine, "viewport": [width, height], "console_errors": console_errors,
+                                         "failed_responses": failed_responses})
+                finally:
+                    browser.close()
+    finally:
+        # Written on red too: a failure keeps its machine evidence.
+        (output / "observation.json").write_text(json.dumps({
+            "scope": __doc__, "candidate_identity": direct_server_with_data["candidate_identity"],
+            "candidate_version": direct_server_with_data["candidate_version"], "source_sha256": sources,
+            "observations": observations, "form_requests": requests, "writes": writes}, indent=2), encoding="utf-8")
