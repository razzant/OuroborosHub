+def test_deferred_continuing_and_child_outputs_are_sent_once_by_their_canonical_identity(env):
+    from ouroboros.presence_continuation import output_ref
+    from ouroboros.tools.registry import ToolContext
+
+    _receive(env, _message(40, "Do the long thing"), 30)
+    _run(env, lambda: env.wire.sent())
+    template = copy.deepcopy(env.model.tasks[0])
+    template["metadata"]["presence"]["delivery_reporting_version"] = 1
+    key = template["metadata"]["presence"]["event"]["conversation_key"]
+
+    def selected(tid, words, *, status="completed", continuation=None):
+        task = {**copy.deepcopy(template), "id": tid}
+        ctx = ToolContext(repo_dir=env.root, drive_root=env.root, budget_drive_root=env.root, task_id=tid,
+                          task_metadata=task["metadata"])
+        result = build_presence_result_event(task, words, ctx, terminal_origin="model_final")
+        write_task_result(env.root, tid, status, metadata=task["metadata"], terminal_origin="model_final",
+                          result=words, **({"presence_continuation": continuation} if continuation else {}))
+        return result["output_ref"]
+
+    write_task_result(env.root, "late-child", "running", metadata=copy.deepcopy(template["metadata"]))
+    released = output_ref("continuing", "released-selection", key)
+    selected("continuing", "Final words", continuation={
+        "initial": {"work_ref": "late-child"}, "child_work_ref": "late-child",
+        "outputs": [{"output_ref": released, "outcome": "message", "text": "Early words"}]})
+    legacy_meta = {k: v for k, v in copy.deepcopy(template["metadata"]).items()  # no output identity was minted
+                   if not k.startswith("presence_") or k == "presence_event_identity"}
+    write_task_result(env.root, "legacy", "completed", metadata=legacy_meta, terminal_origin="model_final",
+                      result="Unidentified words")
+    for ref in ("continuing", "legacy"):
+        env.tp._observe_ref(env.api, ref, 30, env.place.place_id)
+    _run(env, lambda: {"Early words", "Final words"} <= {d["text"] for d in env.wire.sent()}
+         and _custody(env, "SELECT state FROM work WHERE ref='late-child'"))
+    assert _custody(env, "SELECT state FROM work WHERE ref='late-child'")[0]["state"] == "observe", "pending child"
+    selected("late-child", "Child words")
+    env.tp._exec(env.api, "UPDATE work SET available_at=0")
+    _run(env, lambda: "Child words" in {d["text"] for d in env.wire.sent()})
+    env.tp._exec(env.api, "UPDATE work SET state='observe', available_at=0")  # polled again: nothing new is sent
+    _run(env, lambda: not _custody(env, "SELECT 1 FROM work WHERE state='observe'"))
+    texts = [d["text"] for d in env.wire.sent()]
+    assert texts.count("Early words") == texts.count("Final words") == texts.count("Child words") == 1
+    legacy = json.loads(_custody(env, "SELECT last_json FROM work WHERE ref='legacy'")[0]["last_json"])
+    assert legacy["output_ref"] == "" and "Unidentified words" not in texts, legacy
+    assert legacy["outcome"] == "message", "the Host selected it, but without an identity"
+    assert _custody(env, "SELECT ref FROM gaps WHERE ref='work:legacy'"), "a recorded gap, never sent"
+
