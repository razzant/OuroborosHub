+def _focus(env, chat, mid, text, during):
+    """Run one real Host focus for a private message and call ``during(task)`` inside it."""
+    message = {"message_id": mid, "date": int(time.time()), "chat": {"id": chat, "type": "private"},
+               "from": {"id": chat, "first_name": "Ann" if chat == OWNER else "Guest"}, "text": text}
+    env.tp.commit(env.api, mid, message, owner=chat == OWNER, lane="presence", place_id=env.place.place_id)
+    results = {}
+    env.model.during = lambda task: results.update(during(task) or {})
+    runner = env.tp.Runner(env.api, client_factory=lambda: env.wire, classic=None)
+
+    async def drive():
+        deadline = time.monotonic() + 20
+        while time.monotonic() < deadline and not results:
+            await runner.tick()
+            await asyncio.sleep(0.05)
+        await runner.stop()
+    asyncio.run(drive())
+    assert results, "the focus never ran"
+    return results
+
+
+def _outcome(result):
+    return result.status, result.code
