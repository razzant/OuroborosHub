+def test_second_message_reaches_the_live_author_while_the_poller_keeps_serving_fast_controls(env):
+    from ouroboros.owner_mailbox import _mailbox_path
+
+    env.model.hold.clear()  # the first focus stays open as the conversation's author
+    env.wire.updates = [[_poll(1, _message(10, "First thought"))]]
+    quiz = sys.modules[env.plugin.__package__ + ".lib.telegram_quiz"]
+    for card, quiz_id in ((300, "q-tap"), (301, "q-reply")):
+        quiz.remember_quiz(env.api, quiz.mint_token("asker", quiz_id), {
+            "task_id": "asker", "quiz_id": quiz_id, "chat_id": OWNER, "message_id": card,
+            "options": ["Yes", "No"], "text": "Proceed?"})
+    tap = {"id": "cb1", "data": f"qz:{quiz.mint_token('asker', 'q-tap')}:0", "from": {"id": OWNER},
+           "message": {"message_id": 300, "chat": {"id": OWNER, "type": "private"}}}
+    document = _message(11, "", document={"file_id": "f1", "file_name": "logs.txt", "file_size": 10},
+                        caption="Also check these logs")
+    document.pop("text")
+
+    async def scenario():
+        poller = asyncio.create_task(env.plugin._poller(env.api))
+        runner = asyncio.create_task(env.runner.run())
+        try:
+            await _wait(lambda: env.model.tasks)
+            author = env.model.tasks[0]["id"]
+            env.wire.updates.append([_poll(2, document), _poll(3, _message(12, "/panic")),
+                                     _poll(4, _message(13, "/menu")), _poll(5, callback_query=tap),
+                                     _poll(6, _message(14, "The second one, please", reply_to_message={"message_id": 301}))])
+            await _wait(lambda: any(payload.get("text") == "/panic" for _path, payload in env.injects))
+            await _wait(lambda: [path for path, _p in env.injects].count("/chat/decision") == 2)
+            header, _keyboard = env.plugin._build_menu_keyboard("full_access", env.plugin._poller_preferences(env.api)[4])
+            await _wait(lambda: header in [data["text"] for data in env.wire.sent()])
+            assert not env.model.hold.is_set() and len(env.model.tasks) == 1, "fast controls did not wait for the turn"
+            mailbox = _mailbox_path(env.root, author)
+            await _wait(lambda: mailbox.exists() and "Also check these logs" in mailbox.read_text())
+            # The Host files the mail, then answers the request: the custody row settles right after.
+            await _wait(lambda: _custody(env, "SELECT state FROM inbox WHERE update_id=2")[0]["state"] == "settled")
+            second = _custody(env, "SELECT * FROM inbox WHERE update_id=2")[0]
+            assert json.loads(second["receipt_json"])["outcome"] == "silent"
+            mail = json.loads(json.loads(mailbox.read_text().splitlines()[-1])["text"])
+            held = [row for row in mail.get("attachment_manifest") or [] if row.get("status") == "staged"]
+            assert held and all(Path(row["abs_path"]).is_file() for row in held), "the Host holds its own copy"
+            assert not (env.api.state_dir / "places_staging" / "2").exists(), "ours is released after capture"
+            env.model.hold.set()
+            await _wait(lambda: any("First thought" in data["text"] for data in env.wire.sent()))
+        finally:
+            env.model.hold.set()
+            for task in (poller, runner):
+                task.cancel()
+            await asyncio.gather(poller, runner, return_exceptions=True)
+
+    asyncio.run(scenario())
+    assert len(env.model.tasks) == 1, "the second message joined the open focus as context, not a new turn"
+    assert [p for path, p in env.injects if path == "/chat/inject" and p.get("text") != "/panic"] == []
+    decisions = [p for path, p in env.injects if path == "/chat/decision"]
+    assert decisions[1]["comment"] == "The second one, please", "a quiz reply stays the owner's verbatim answer"
+    assert not _custody(env, "SELECT 1 FROM inbox WHERE update_id IN (3,4,5,6)"), "fast paths never enter custody"
+    assert json.loads((env.api.state_dir / "poll_offset.json").read_text())["offset"] == 7
