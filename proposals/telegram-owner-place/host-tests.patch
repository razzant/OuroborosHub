+"""The Telegram place tools through the production tool dispatcher.
+
+A genuine extension is loaded by ``extension_loader.load_extension`` from the real skill
+payload (its ``lib/`` and ``plugin.py``) with the real manifest's ``tools:`` effects and
+place contribution; its entry registers exactly the production tool handlers, without
+the bridge's pollers. Calls go through ``ToolRegistry.execute_result`` with a real
+``ToolContext`` inside real Host focus turns, so the production order applies: Advises
+(Observe) refusal and the Silent/Paused place guard, liveness, the real Safety check
+(only its model call is stubbed), the handler, and the typed reading of an ``ok:false``
+body. Telegram is a recorded wire; the owner ingress is the Host's real ``/chat/inject``.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import re
+import shutil
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from ouroboros import extension_loader, places
+from ouroboros.gateway import host_service
+from ouroboros.presence_runner import build_presence_result_event, run_presence_turn
+from ouroboros.skill_loader import (SkillReviewState, find_skill, save_enabled, save_review_state,
+                                    save_skill_grants, skill_state_dir)
+from ouroboros.task_results import write_task_result
+from ouroboros.tools.registry import ToolContext, ToolRegistry
+from tests._shared import clean_extension_runtime_state
+
+pytestmark = pytest.mark.serial
+
+SKILL = Path(__file__).resolve().parents[1] / "skills" / "telegram"
+BOT, OWNER, GUEST = "777", 42, 99
+ENTRY = '''
+from .lib import telegram_actions
+from . import plugin as classic
+
+CLIENT = None
+
+
+def register(api):
+    telegram_actions.register_tools(api, client_factory=lambda: CLIENT, relay=classic._relay_owner_message,
+                                    owner=lambda: str(classic._load_settings(api).get("TELEGRAM_CHAT_ID") or ""))
+'''
+
+
+def _frontmatter_block(name: str) -> str:
+    text = (SKILL / "SKILL.md").read_text(encoding="utf-8")
+    match = re.search(rf"^{name}:\n(?:  .*\n)+", text, re.M)
+    assert match, name
+    return match.group(0)
+
+
+class Wire:
+    def __init__(self):
+        self.calls, self.next_id = [], 500
+
+    async def call(self, method, *, data=None, files=None, timeout=30):
+        self.calls.append((method, dict(data or {})))
+        if method == "setMessageReaction":
+            return {"ok": True, "result": True}
+        self.next_id += 1
+        return {"ok": True, "result": {"message_id": self.next_id, "date": 1_800_000_000}}
+
+    async def download_photo(self, _file_id):
+        return "aGVsbG8=", "image/jpeg"
+
+    async def download_file(self, _file_id):
+        return b"bytes"
+
+    async def send_message(self, chat_id, text, parse_mode="HTML"):
+        return (await self.call("sendMessage", data={"chat_id": str(chat_id), "text": text}))["result"]["message_id"]
+
+
+class Api:
+    """The runner's view of the same skill state the loaded extension uses."""
+
+    def __init__(self, state_dir, data_dir):
+        self.state_dir, self.data_dir = Path(state_dir), Path(data_dir)
+
+    def get_state_dir(self):
+        return str(self.state_dir)
+
+    def get_runtime_info(self):
+        return {"data_dir": str(self.data_dir)}
+
+    def get_skill_token(self):
+        return SimpleNamespace(use_in_request=lambda: "synthetic")
+
+    def log(self, *_args):
+        pass
+
+
+class Bridge:
+    def __init__(self):
+        self.messages = []
+
+    def enqueue_local_message(self, text, **kwargs):
+        self.messages.append({"text": text, **kwargs})
+
+
+class Model:
+    def __init__(self, root):
+        self.root, self.tasks, self.during = root, [], None
+
+    def handle_task(self, task):
+        self.tasks.append(task)
+        if self.during is not None:
