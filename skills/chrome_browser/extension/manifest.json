{
  "manifest_version": 3,
  "name": "Ouroboros Chrome Browser",
  "description": "Lets one Ouroboros task act in tabs you explicitly share. Pairing and sharing are manual; nothing is shared by installing.",
  "version": "0.1.2",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ouroboros Chrome Browser",
    "default_popup": "popup.html"
  }
}
