{
  "display_information": {
    "name": "Ouroboros",
    "description": "Ouroboros Slack presence transport",
    "background_color": "#12141a"
  },
  "features": {
    "bot_user": {
      "display_name": "Ouroboros",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "channels:join",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "users:read",
        "users:read.email",
        "reactions:read",
        "reactions:write",
        "pins:read",
        "pins:write",
        "bookmarks:read",
        "bookmarks:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "app_mention",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
